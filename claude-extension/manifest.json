{
  "manifest_version": "0.2",
  "name": "assignment-manager",
  "display_name": "Assignment Manager",
  "version": "1.2.0",
  "description": "Let Claude read and manage your client assignments, IDs and deadlines from the Assignment Manager desktop app.",
  "long_description": "Connects Claude to the Assignment Manager desktop app's local database (~/.assignment_manager/assignments.db). Ask Claude what's due, add or update assignments, change status or payment, and get deadline summaries. Changes appear in the desktop app within a minute.",
  "author": { "name": "Sunit Sah" },
  "server": {
    "type": "python",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "python3",
      "args": ["${__dirname}/server/main.py"],
      "env": {}
    }
  },
  "tools": [
    { "name": "get_summary", "description": "Dashboard summary and current deadline" },
    { "name": "get_upcoming_deadlines", "description": "Overdue and upcoming deadlines" },
    { "name": "list_assignments", "description": "List and filter assignments" },
    { "name": "get_assignment", "description": "All details of one assignment" },
    { "name": "add_assignment", "description": "Create a new assignment" },
    { "name": "update_assignment", "description": "Update fields of an assignment" },
    { "name": "delete_assignment", "description": "Delete an assignment" }
  ],
  "keywords": ["assignments", "deadlines", "productivity"],
  "license": "MIT",
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": { "python": ">=3.8" }
  }
}
